# ==============================================================================
# Card Statement Manager - 環境設定範例檔 (.env.example)
# 使用方法：請複製此檔案並重新命名為「.env」，並填入您的專屬設定值。
# 安全提醒：此 .env 檔案包含機敏資訊，已設定於 .gitignore 中，請勿推送到遠端 Git 倉庫。
# ==============================================================================

# --- Google OAuth 2.0 憑證設定 ---
# 取得方式：前往 Google Cloud Console (https://console.cloud.google.com)
# 1. 建立一個專案，並啟用 "Google Drive API" 與 "Google People API"。
# 2. 前往「OAuth 同意畫面」設定為外部或內部應用程式。
# 3. 前往「憑證」建立一組「OAuth 2.0 用戶端 ID」（應用程式類型選擇：Web 應用程式）。
# 4. 新增已授權的重新導向 URI：http://127.0.0.1:8000/api/auth/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/auth/callback"

# --- 後端安全 Session 與資料加密金鑰 ---
# SESSION_SECRET_KEY: 用於簽署加密 Session Cookie 的任意隨機字串
SESSION_SECRET_KEY="card_statement_manager_session_secure_secret_key_2026"
# ENCRYPTION_KEY: 用於 AES-256 對稱加密存儲 Refresh Token 的 32 位元 Base64 金鑰
# 產生方式（Python）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="YOUR_32_BYTE_BASE64_CRYPTOGRAPHY_FERNET_KEY"

# --- AI 辨識 Gemini API Key ---
# 取得方式：前往 Google AI Studio (https://aistudio.google.com)
# 系統預設會自動運行於「免金鑰擬真體驗模式」，若要開啟真實 AI 辨識與分析，請填入此金鑰
GEMINI_API_KEY=""

# --- 地端目錄自動掃描路徑設定 ---
# 當使用者使用「地端訪客模式」點擊掃描資料夾時，系統預設搜尋的本機資料夾路徑
DEFAULT_LOCAL_SCAN_FOLDER="C:/Users/ting_hsia/Downloads/Bills"
